# ==================================
# 生产环境配置模板
# 复制此文件为 .env.prod 并填入真实值
# ==================================
# 优先级：OS 环境变量 > .env.prod > .env（公共） > 代码默认值
#
# 本文件只包含开发者通常需要修改的配置项，其余属性使用代码默认值。
# ==================================

ENVIRONMENT = "prod"

# ==================================
# 服务器配置
# ==================================
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 6100

# ==================================
# API文档配置
# ==================================
TITLE = "🎉 FastapiAdmin 🎉 -prod"
VERSION = "3.1.0"
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"
ROOT_PATH = "/api/v1"

# ==================================
# 调试模式
# ==================================
DEBUG = False
LOGGER_LEVEL = "INFO"  # (DEBUG/INFO/WARNING/ERROR)

# ==================================
# 跨域配置（CORS）
# ==================================
CORS_ORIGIN_ENABLE = True
ALLOW_ORIGINS = ["*"]

# ==================================
# JWT 密钥（生产环境务必更换）
# ==================================
SECRET_KEY = "your-prod-secret-key-change-me"
TOKEN_TYPE = "bearer"
ACCESS_TOKEN_EXPIRE_SECONDS = 1800        # 秒；1800 秒 = 30 分钟
REFRESH_TOKEN_EXPIRE_SECONDS = 1800       # 秒；1800 秒 = 30 分钟

# ==================================
# 数据库连接
# ==================================
DATABASE_TYPE = "mysql"
DATABASE_HOST = "your_database_host"
DATABASE_PORT = 3306
DATABASE_USER = "root"
DATABASE_PASSWORD = "your_database_password"
DATABASE_NAME = "fastapiadmin"

# ==================================
# Redis
# ==================================
REDIS_ENABLE = True
REDIS_HOST = "your_redis_host"
REDIS_PORT = 6379
REDIS_PASSWORD = "your_redis_password"

# ==================================
# 微信小程序（wx_mini 登录，生产必填）
# ==================================
# 留空时 /system/auth/wx-* 端点报「微信小程序未配置」
WX_MINI_APP_ID = "your-wx-miniprogram-appid"
WX_MINI_APP_SECRET = "your-wx-miniprogram-appsecret"
