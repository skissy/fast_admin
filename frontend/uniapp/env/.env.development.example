# 开发环境变量（本地文件，被 .gitignore 忽略；模板见 .env.development.example）
VITE_APP_PORT=6120
VITE_AUTH_MODE=double

# 后端地址：请求层拼 VITE_API_BASE_URL + VITE_APP_BASE_API（后端统一前缀 /api/v1）
VITE_API_BASE_URL=http://127.0.0.1:6100
# 备用接口域名（可选；留空则回退 VITE_API_BASE_URL，经 @/http 的 API_DOMAINS.SECONDARY + meta.domain 直连）
VITE_API_BASE_URL_SECONDARY=
VITE_APP_BASE_API=/api/v1

# H5 dev server 代理开关（小程序端不生效；H5 需要代理时改 true）
VITE_APP_PROXY_ENABLE=true

VITE_APP_TITLE=FastapiAdmin
VITE_DELETE_CONSOLE=false
VITE_COPY_NATIVE_RES_ENABLE=false

# 微信小程序 AppID（须与后端 WX_MINI_APP_ID 一致，否则 uni.login 的 code
# 会以 touristappid 签发，code2Session 报 [40029] invalid code）
VITE_WX_APPID=your_mp_weixin_appid
