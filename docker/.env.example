# ============================================
# Docker Compose 变量文件（只放 compose 插值用的变量）
# 用法：cp .env.example .env 后填写真实密码
#
# 应用自身的配置不在这里：
#   方式 A（全套）  → backend/env/.env.prod
#   方式 B（仅后端）→ 与编排文件同级的 env.prod
# 详见 docker/README.md
# ============================================

# ---- 后端 ----
BACKEND_PORT=6100        # 宿主机映射端口（容器内固定 6100）
BACKEND_IMAGE=ghcr.io/skissy/fast_admin-backend # GitHub CI 自动发布；本地构建可改为 fast_admin-backend
IMAGE_TAG=latest         # 生产可固定为版本号或 sha-<完整提交SHA>

# ---- Nginx（仅方式 A 使用）----
HTTP_PORT=80
HTTPS_PORT=443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fast_admin
MYSQL_USER=fast_admin
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
